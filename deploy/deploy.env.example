# Copy to deploy/deploy.env (git-ignored) and fill in your own values.
SERVER=user@192.0.2.10              # ssh target of your home server
APP_USER=user                       # Linux user that runs StudyHub on the server
REMOTE=/home/user/studyhub          # contains studyhub/ (code), .venv/ and data/
ORIGIN=https://study.example.com    # public HTTPS address of your personal site
SERVICE=studyhub                    # systemd unit name of your personal site
PORT=8091
FRIENDS_NAME=study-friends          # loophole hostname for the multi-user site (https://NAME.loophole.site)
OWNER_NAME=                         # your name, shown in the greeting (optional)
COLLEGE_CODE=                       # faculty code friends type at sign-up to see the college archive/tasks (e.g. cs)
